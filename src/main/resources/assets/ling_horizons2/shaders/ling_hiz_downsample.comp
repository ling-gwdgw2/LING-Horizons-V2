#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(r32f, binding = 0) uniform writeonly image2D uDstImage;
layout(binding = 0) uniform sampler2D uSrcSampler;
layout(r32f, binding = 1) uniform readonly image2D uSrcImage;

uniform int uSrcLevel; // -1 for initial copy from main depth buffer, >= 0 for mip pyramid
uniform ivec2 uDstSize;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= uDstSize.x || coord.y >= uDstSize.y) return;

    float maxDepth;
    if (uSrcLevel < 0) {
        // Base mip 0: downsample from main depth buffer
        vec2 texelSize = 1.0 / vec2(uDstSize);
        vec2 uv = (vec2(coord) + 0.5) * texelSize;
        vec2 halfTexel = 0.25 * texelSize;

        float d0 = textureLod(uSrcSampler, uv + vec2(-halfTexel.x, -halfTexel.y), 0.0).r;
        float d1 = textureLod(uSrcSampler, uv + vec2( halfTexel.x, -halfTexel.y), 0.0).r;
        float d2 = textureLod(uSrcSampler, uv + vec2(-halfTexel.x,  halfTexel.y), 0.0).r;
        float d3 = textureLod(uSrcSampler, uv + vec2( halfTexel.x,  halfTexel.y), 0.0).r;

        maxDepth = max(max(d0, d1), max(d2, d3));
    } else {
        // Higher mip levels: read 2x2 from previous mip level via imageLoad (completely avoids texture sampler hazard)
        ivec2 srcCoord = coord * 2;
        float d0 = imageLoad(uSrcImage, srcCoord + ivec2(0, 0)).r;
        float d1 = imageLoad(uSrcImage, srcCoord + ivec2(1, 0)).r;
        float d2 = imageLoad(uSrcImage, srcCoord + ivec2(0, 1)).r;
        float d3 = imageLoad(uSrcImage, srcCoord + ivec2(1, 1)).r;

        maxDepth = max(max(d0, d1), max(d2, d3));
    }

    imageStore(uDstImage, coord, vec4(maxDepth, 0.0, 0.0, 0.0));
}
