#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Bounding box and draw parameters for each 32x32x32 section (48 bytes)
struct SectionDrawInfo {
    vec4 minPos;      // xyz = world min (block coords), w = active flag (> 0.0)
    vec4 maxPos;      // xyz = world max (block coords), w = float(quadCount)
    uint firstQuad;   // offset in quad buffer (quad index)
    uint quadCount;   // number of quads in this section
    uint padding0;
    uint padding1;
};

// Standard OpenGL 4.6 DrawArraysIndirectCommand (16 bytes)
struct DrawArraysIndirectCommand {
    uint count;         // vertex count = quadCount * 6
    uint instanceCount; // 1 if visible, 0 if culled
    uint first;         // first vertex index = firstQuad * 6
    uint baseInstance;  // section index
};

layout(std430, binding = 0) readonly buffer SectionBuffer {
    SectionDrawInfo uSections[];
};

layout(std430, binding = 1) writeonly buffer CommandBuffer {
    DrawArraysIndirectCommand uCommands[];
};

layout(std430, binding = 2) buffer CounterBuffer {
    uint uVisibleCount;
};

// Frustum planes in camera-relative space: ax + by + cz + d = 0
uniform vec4 uFrustumPlanes[6];
uniform vec3 uCameraPos;
uniform uint uTotalSections;

bool isBoxInFrustum(vec3 bMin, vec3 bMax) {
    for (int i = 0; i < 6; i++) {
        vec4 plane = uFrustumPlanes[i];
        // Calculate positive vertex along plane normal
        vec3 p = bMin;
        if (plane.x >= 0.0) p.x = bMax.x;
        if (plane.y >= 0.0) p.y = bMax.y;
        if (plane.z >= 0.0) p.z = bMax.z;

        if (dot(plane.xyz, p) + plane.w < 0.0) {
            return false; // Outside frustum
        }
    }
    return true;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uTotalSections) return;

    SectionDrawInfo sec = uSections[index];
    if (sec.minPos.w <= 0.0 || sec.quadCount == 0u) {
        // Inactive or empty section
        uCommands[index].count = 0u;
        uCommands[index].instanceCount = 0u;
        uCommands[index].first = 0u;
        uCommands[index].baseInstance = index;
        return;
    }

    // Camera-relative bounding box for culling
    vec3 relMin = sec.minPos.xyz - uCameraPos;
    vec3 relMax = sec.maxPos.xyz - uCameraPos;

    bool visible = isBoxInFrustum(relMin, relMax);

    DrawArraysIndirectCommand cmd;
    cmd.count = sec.quadCount * 6u;
    cmd.instanceCount = visible ? 1u : 0u;
    cmd.first = sec.firstQuad * 6u;
    cmd.baseInstance = index;

    uCommands[index] = cmd;

    if (visible) {
        atomicAdd(uVisibleCount, 1u);
    }
}
